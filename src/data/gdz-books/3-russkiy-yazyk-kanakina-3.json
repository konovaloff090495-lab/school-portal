{"slug": "kanakina-3", "klass": 3, "subjectSlug": "russkiy-yazyk", "subject": "Русский язык", "authors": "Канакина В. П., Горецкий В. Г.", "type": "Учебник", "years": "2019–2023", "publisher": "Просвещение", "fgos": true, "parts": "1, 2", "chapters": [{"title": "Язык и речь. Повторение", "problems": [{"number": "1", "page": 4, "condition": "Разберите слово «красивый» по составу.", "steps": ["Окончание: -ый (красив<b>ый</b>).", "Основа: красив-.", "Корень: красив- (красота, краса).", "Суффикс: нет отдельного суффикса (или -ив-)."], "answer": "красив-ый: корень красив-, окончание -ый."}, {"number": "3", "page": 5, "condition": "Определите части речи: «бежать», «быстрый», «лес».", "steps": ["бежать — глагол (что делать?).", "быстрый — имя прилагательное (какой?).", "лес — имя существительное (что?)."], "answer": "бежать — глагол, быстрый — прилагательное, лес — существительное."}, {"number": "5", "page": 7, "condition": "Определите род имён существительных: «книга», «стол», «окно».", "steps": ["книга — она, моя → женский род.", "стол — он, мой → мужской род.", "окно — оно, моё → средний род."], "answer": "книга — ж.р., стол — м.р., окно — ср.р."}, {"number": "10", "page": 10, "condition": "Измените существительное «дом» по падежам (1–3 падеж).", "steps": ["Именительный (кто? что?): дом.", "Родительный (кого? чего?): дома.", "Дательный (кому? чему?): дому."], "answer": "И.п. — дом, Р.п. — дома, Д.п. — дому."}, {"number": "11", "page": 11, "condition": "Выпишите из предложения имя прилагательное: «Красивый цветок стоит в вазе».", "steps": ["Красивый — отвечает на вопрос «какой?» → прилагательное."], "answer": "красивый — имя прилагательное."}, {"number": "16", "page": 14, "condition": "Найдите в тексте обращение: «Петя, иди сюда!»", "steps": ["Обращение — слово, называющее того, к кому обращаются, выделяется запятой.", "Петя — обращение."], "answer": "Петя — обращение."}, {"number": "23", "page": 18, "condition": "Разберите по членам предложения: «Мальчик читает книгу».", "steps": ["Мальчик — подлежащее (кто?).", "читает — сказуемое (что делает?).", "книгу — дополнение (что?)."], "answer": "Мальчик (подл.) читает (сказ.) книгу (доп.)."}]}, {"title": "Состав слова", "problems": [{"number": "51", "page": 28, "condition": "Выделите корень слова: «подберёзовик».", "steps": ["Родственные слова: берёза, берёзовый, подберёзовик.", "Корень: -берёз-.", "под-берёз-овик."], "answer": "Корень: берёз- (под|берёз|овик)."}, {"number": "55", "page": 30, "condition": "Образуйте слова с приставкой «под-»: ходить, бежать.", "steps": ["ходить → подходить.", "бежать → подбежать."], "answer": "подходить, подбежать."}, {"number": "62", "page": 34, "condition": "Выделите приставку в словах: «прибежал», «написал», «вошёл».", "steps": ["при-бежал, на-писал, во-шёл."], "answer": "при-, на-, во-."}, {"number": "68", "page": 37, "condition": "Образуйте слово с помощью суффикса -ист-: «баян».", "steps": ["баян + -ист- = баянист (тот, кто играет на баяне)."], "answer": "баянист."}, {"number": "75", "page": 41, "condition": "Найдите и объясните орфограмму в слове «лесной».", "steps": ["Лес_ой → корень -лес-, проверочное: лес.", "Безударная гласная е в корне, проверяется: лес."], "answer": "лесной — безударная е проверяется словом «лес»."}, {"number": "140", "page": 72, "condition": "Определите род прилагательного «зелёная трава».", "steps": ["трава — существительное женского рода.", "зелёная — прилагательное женского рода (согласуется с сущ.)."], "answer": "Женский род."}]}, {"title": "Части речи", "problems": [{"number": "131", "page": 68, "condition": "Просклоняйте прилагательное «белый» (единственное число).", "steps": ["И.п. — белый, Р.п. — белого, Д.п. — белому, В.п. — белый/белого, Т.п. — белым, П.п. — о белом."], "answer": "белый, белого, белому, белый, белым, о белом."}, {"number": "148", "page": 76, "condition": "Измените прилагательное «синий» по числам.", "steps": ["Единственное: синий (м.р.), синяя (ж.р.), синее (ср.р.).", "Множественное: синие."], "answer": "синий / синяя / синее; синие (мн.ч.)."}, {"number": "200", "page": 104, "condition": "Найдите числительное в предложении: «Три котёнка играли во дворе».", "steps": ["три — отвечает на вопрос «сколько?» → числительное."], "answer": "три — числительное."}, {"number": "210", "page": 108, "condition": "Просклоняйте существительное «земля» (первые 3 падежа).", "steps": ["И.п. — земля, Р.п. — земли, Д.п. — земле."], "answer": "И.п. земля, Р.п. земли, Д.п. земле."}, {"number": "288", "page": 148, "condition": "Найдите и исправьте орфографическую ошибку: «чюдо».", "steps": ["ЧУ-ШУ пишем с «у»: чудо (не чюдо)."], "answer": "чудо."}]}, {"title": "Правописание", "problems": [{"number": "281", "page": 144, "condition": "Найдите слова с безударной гласной, требующей проверки: «молоко», «стол», «вода».", "steps": ["молоко — безударная гласная О в первом слоге → молОко (проверка: ?).", "стол — гласная О под ударением.", "вода — безударная О → воды (ударная)."], "answer": "молоко, вода — безударные гласные требуют проверки."}, {"number": "295", "page": 152, "condition": "Вставьте разделительный ь: «вороб_и», «лист_я».", "steps": ["воробьи — перед и после согласной: воробьи.", "листья — перед я: листья."], "answer": "воробьи, листья."}, {"number": "305", "page": 156, "condition": "Проверьте написание парной согласной: «моро_» (мороз/морос?).", "steps": ["Подбираем форму с гласной после согласной: мороз → морозы (з!).", "мороЗ."], "answer": "мороЗ (проверка: морозы)."}]}], "source": "reshak"}