{"slug": "kolmogorov-11", "klass": 11, "subjectSlug": "algebra-nachala-analiza", "subject": "Алгебра и начала анализа", "authors": "Колмогоров А. Н., Абрамов А. М., Дудницын Ю. П.", "type": "Учебник", "years": "2019–2023", "publisher": "Просвещение", "fgos": true, "parts": "1", "chapters": [{"title": "§ 1. Производная (углублённо)", "problems": [{"number": "1", "page": 4, "condition": "Найдите производную <b>y = sin x</b>.", "steps": ["(sin x)′ = cos x."], "formulas": ["(sin x)' = cos x"], "answer": "y' = cos x."}, {"number": "5", "page": 7, "condition": "Могут ли синус и косинус одного и того же числа быть равными.", "steps": ["Производная экспоненты: (eˣ)′ = eˣ."], "formulas": ["(eˣ)' = eˣ"], "answer": "y' = eˣ."}, {"number": "2", "page": 5, "condition": "Найдите производную <b>y = x³ − 3x² + 2</b>.", "steps": ["y' = 3x² − 6x."], "formulas": ["(xⁿ)' = nxⁿ⁻¹"], "answer": "y' = 3x² − 6x."}, {"number": "6", "page": 8, "condition": "Найдите производную <b>y = ln x</b>.", "steps": ["(ln x)' = 1/x."], "formulas": ["(ln x)' = 1/x"], "answer": "y' = 1/x."}, {"number": "8", "page": 10, "condition": "Найдите точки экстремума: <b>y = x² − 4x + 3</b>.", "steps": ["y' = 2x − 4 = 0 → x = 2.", "y''(2) = 2 > 0 → минимум.", "y_min = 4 − 8 + 3 = −1."], "answer": "x = 2 — минимум, y_min = −1."}, {"number": "11", "page": 12, "condition": "Вычислите <b>∫ (3x² + 2x) dx</b>.", "steps": ["= x³ + x² + C."], "formulas": ["∫ xⁿ dx = xⁿ⁺¹/(n+1) + C"], "answer": "x³ + x² + C."}]}, {"title": "§ 2. Интеграл", "problems": [{"number": "10", "page": 11, "condition": "Найдите интеграл: <b>∫ cos x dx</b>.", "steps": ["∫ cos x dx = sin x + C."], "formulas": ["∫ cos x dx = sin x + C"], "answer": "sin x + C."}, {"number": "15", "page": 15, "condition": "Вычислите определённый интеграл: <b>∫₀^(π/2) sin x dx</b>.", "steps": ["= [−cos x]₀^(π/2) = −cos(π/2) + cos 0 = 0 + 1 = 1."], "answer": "1."}, {"number": "20", "page": 19, "condition": "Решите уравнение: <b>2ˣ = 8</b>.", "steps": ["8 = 2³.", "2ˣ = 2³ → x = 3."], "answer": "x = 3."}, {"number": "16", "page": 16, "condition": "Вычислите <b>∫₀¹ (x² + 1) dx</b>.", "steps": ["= [x³/3 + x]₀¹ = (1/3 + 1) − 0 = 4/3."], "answer": "4/3."}, {"number": "18", "page": 18, "condition": "Найдите площадь фигуры, ограниченной <b>y = x²</b> и <b>y = x</b>.", "steps": ["Пересечение: x² = x → x(x−1) = 0 → x = 0, 1.", "S = ∫₀¹ (x − x²) dx = [x²/2 − x³/3]₀¹ = 1/2 − 1/3 = 1/6."], "answer": "S = 1/6."}, {"number": "22", "page": 22, "condition": "Решите уравнение: <b>3ˣ = 81</b>.", "steps": ["81 = 3⁴.", "x = 4."], "answer": "x = 4."}]}, {"title": "§ 3. Показательные и логарифмические уравнения", "problems": [{"number": "25", "page": 24, "condition": "Решите уравнение: <b>log₃ x = 2</b>.", "steps": ["x = 3² = 9."], "answer": "x = 9."}, {"number": "30", "page": 28, "condition": "Решите неравенство: <b>log₂ x > 3</b>.", "steps": ["x > 2³ = 8.", "D: x > 0. Ответ: x > 8."], "answer": "x > 8."}, {"number": "27", "page": 26, "condition": "Решите уравнение: <b>log₅(x − 1) = 2</b>.", "steps": ["x − 1 = 5² = 25.", "x = 26."], "answer": "x = 26."}, {"number": "32", "page": 30, "condition": "Решите неравенство: <b>eˣ > e²</b>.", "steps": ["Функция eˣ возрастает.", "x > 2."], "answer": "x > 2."}]}, {"title": "§ 4. Тригонометрические уравнения", "problems": [{"number": "35", "page": 32, "condition": "Решите уравнение: <b>cos x = 0</b>.", "steps": ["x = π/2 + πn, n ∈ ℤ."], "answer": "x = π/2 + πn."}, {"number": "40", "page": 36, "condition": "Вычислите: <b>∫₁² (2x + 1) dx</b>.", "steps": ["= [x² + x]₁² = (4 + 2) − (1 + 1) = 6 − 2 = 4."], "answer": "4."}, {"number": "36", "page": 33, "condition": "Решите уравнение: <b>sin x = √2/2</b>.", "steps": ["x = π/4 + 2πn или x = 3π/4 + 2πn, n ∈ ℤ."], "answer": "x = π/4 + 2πn; x = 3π/4 + 2πn."}, {"number": "42", "page": 37, "condition": "Решите уравнение: <b>tan x = 1</b>.", "steps": ["x = π/4 + πn, n ∈ ℤ."], "answer": "x = π/4 + πn."}]}], "source": "reshak"}