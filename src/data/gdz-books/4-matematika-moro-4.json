{"slug": "moro-4", "klass": 4, "subjectSlug": "matematika", "subject": "Математика", "authors": "Моро М. И., Бантова М. А., Бельтюкова Г. В.", "type": "Учебник", "years": "2019–2023", "publisher": "Просвещение", "fgos": true, "parts": "1, 2", "chapters": [{"title": "Числа. Четыре арифметических действия", "problems": [{"number": "1", "page": 4, "condition": "Вычисли: 3456 + 2178 = ?", "steps": ["Складываем столбиком: 6+8=14 (4, перенос 1); 5+7+1=13 (3, перенос 1); 4+1+1=6; 3+2=5.", "3456 + 2178 = 5634."], "answer": "5634."}, {"number": "2", "page": 4, "condition": "Вычисли: 7000 − 3456 = ?", "steps": ["7000 − 3456 = 3544.", "Проверка: 3544 + 3456 = 7000 ✓."], "answer": "3544."}, {"number": "3", "page": 5, "condition": "Вычисли: 234 · 4 = ?", "steps": ["234 · 4 = 200·4 + 30·4 + 4·4 = 800 + 120 + 16 = 936."], "answer": "936."}, {"number": "5", "page": 7, "condition": "Найди площадь прямоугольника 6 см × 8 см.", "steps": ["S = a · b = 6 · 8 = 48 см²."], "formulas": ["S = ab"], "answer": "48 см²."}, {"number": "10", "page": 10, "condition": "Реши задачу: Поезд прошёл 360 км за 4 ч. С какой скоростью?", "steps": ["v = s / t = 360 / 4 = 90 км/ч."], "formulas": ["v = s/t"], "answer": "90 км/ч."}, {"number": "15", "page": 14, "condition": "Запиши число 3/4 как долю единицы. Что означает дробь 3/4?", "steps": ["3/4 означает: единица разделена на 4 части, взяты 3 из них.", "3/4 < 1."], "answer": "Три четверти целого. 3/4 < 1."}, {"number": "20", "page": 18, "condition": "Реши задачу: Купили 3 кг конфет по 120 руб./кг. Сколько заплатили?", "steps": ["3 · 120 = 360 руб."], "answer": "360 рублей."}, {"number": "21", "page": 19, "condition": "Реши: 2 345 · 3 = ?", "steps": ["2345 · 3 = 7035.", "2000·3 + 300·3 + 40·3 + 5·3 = 6000+900+120+15 = 7035."], "answer": "7035."}, {"number": "25", "page": 21, "condition": "Реши: 1248 : 4 = ?", "steps": ["1248 : 4 = 312.", "1200:4=300, 48:4=12, 300+12=312."], "answer": "312."}, {"number": "30", "page": 23, "condition": "Реши задачу: Автомобиль проехал 240 км за 3 ч. Найди скорость.", "steps": ["v = s/t = 240/3 = 80 км/ч."], "answer": "80 км/ч."}, {"number": "38", "page": 20, "condition": "Реши: 4 367 + 2 518 = ?", "steps": ["7+8=15, пишем 5 перенос 1; 6+1+1=8; 3+5=8; 4+2=6.", "6 885."], "answer": "6 885."}, {"number": "46", "page": 24, "condition": "Реши: 7 000 − 3 456 = ?", "steps": ["Последовательно занимаем.", "7000 − 3456 = 3544."], "answer": "3 544."}, {"number": "56", "page": 29, "condition": "Реши: 345 · 6 = ?", "steps": ["5·6=30, пишем 0 перенос 3; 4·6+3=27, пишем 7 перенос 2; 3·6+2=20.", "2 070."], "answer": "2 070."}, {"number": "64", "page": 33, "condition": "Реши: 648 : 4 = ?", "steps": ["6:4=1 ост.2; 24:4=6; 8:4=2.", "162."], "answer": "162."}, {"number": "72", "page": 37, "condition": "В 3 ящиках по 24 кг яблок, ещё в 2 ящиках — по 18 кг. Сколько килограммов яблок всего?", "steps": ["3·24 + 2·18 = 72 + 36 = 108 кг."], "answer": "108 кг."}, {"number": "80", "page": 41, "condition": "Реши: 1 254 · 8 = ?", "steps": ["4·8=32 (пишем 2, перенос 3); 5·8+3=43 (пишем 3, перенос 4); 2·8+4=20 (пишем 0, перенос 2); 1·8+2=10.", "10 032."], "answer": "10 032."}]}, {"title": "Дроби", "problems": [{"number": "91", "page": 47, "condition": "Запиши дроби: один из пяти, три из восьми.", "steps": ["один из пяти = 1/5.", "три из восьми = 3/8."], "answer": "1/5 и 3/8."}, {"number": "95", "page": 49, "condition": "Сравни дроби: 1/2 ○ 1/3.", "steps": ["При одинаковом числителе большая дробь та, у которой меньший знаменатель.", "1/2 > 1/3."], "answer": "1/2 > 1/3."}, {"number": "103", "page": 53, "condition": "Сравни дроби: 3/5 ○ 3/7.", "steps": ["Числители равны, сравниваем знаменатели: 5 < 7.", "Чем меньше знаменатель, тем больше дробь: 3/5 > 3/7."], "answer": "3/5 > 3/7."}, {"number": "108", "page": 55, "condition": "Реши: 1/4 + 2/4 = ?", "steps": ["Знаменатели одинаковы: складываем числители.", "(1+2)/4 = 3/4."], "answer": "3/4."}, {"number": "115", "page": 59, "condition": "Разрезали ленту длиной 3/4 м, используя 1/4 м. Сколько метров ленты осталось?", "steps": ["3/4 − 1/4 = 2/4 = 1/2 м."], "answer": "1/2 м."}]}, {"title": "Скорость, время, расстояние", "problems": [{"number": "171", "page": 87, "condition": "Реши задачу: велосипедист едет 15 км/ч. Какое расстояние проедет за 3 ч?", "steps": ["s = v · t = 15 · 3 = 45 км."], "answer": "45 км."}, {"number": "178", "page": 91, "condition": "Реши: s = v · t. v = 80 км/ч, t = 4 ч. Найди s.", "steps": ["s = 80 · 4 = 320 км."], "answer": "320 км."}, {"number": "185", "page": 95, "condition": "Реши: v = s : t. s = 450 км, t = 5 ч. Найди v.", "steps": ["v = 450 : 5 = 90 км/ч."], "answer": "90 км/ч."}]}, {"title": "Геометрия и величины", "problems": [{"number": "251", "page": 128, "condition": "Переведи: 2 ч 30 мин = ? мин.", "steps": ["2 ч = 120 мин. 120 + 30 = 150 мин."], "answer": "150 минут."}, {"number": "255", "page": 130, "condition": "Найди периметр и площадь квадрата 9 см.", "steps": ["P = 4·9 = 36 см. S = 9² = 81 см²."], "answer": "P = 36 см, S = 81 см²."}, {"number": "265", "page": 136, "condition": "Найди объём прямоугольного параллелепипеда: 5 × 4 × 3 см.", "steps": ["V = a · b · c = 5 · 4 · 3 = 60 см³."], "answer": "60 см³."}, {"number": "272", "page": 139, "condition": "Переведи: 3 км 400 м = ? м.", "steps": ["3 км = 3000 м. 3000 + 400 = 3400 м."], "answer": "3 400 м."}]}], "source": "reshak"}