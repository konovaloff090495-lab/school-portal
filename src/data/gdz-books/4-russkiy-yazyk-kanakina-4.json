{"slug": "kanakina-4", "klass": 4, "subjectSlug": "russkiy-yazyk", "subject": "Русский язык", "authors": "Канакина В. П., Горецкий В. Г.", "type": "Учебник", "years": "2019–2023", "publisher": "Просвещение", "fgos": true, "parts": "1, 2", "chapters": [{"title": "Повторение", "problems": [{"number": "1", "page": 4, "condition": "Определите падеж существительного: «читаю книгу».", "steps": ["книгу — кого? что? → Винительный падеж.", "Предлога нет."], "answer": "Винительный падеж (В.п.)."}, {"number": "3", "page": 6, "condition": "Просклоняйте существительное «школа» по падежам.", "steps": ["И.п. — шко́ла.", "Р.п. — шко́лы.", "Д.п. — шко́ле.", "В.п. — шко́лу.", "Т.п. — шко́лой.", "П.п. — о шко́ле."], "answer": "школа, школы, школе, школу, школой, о школе."}, {"number": "5", "page": 8, "condition": "Определите время глагола: «читал», «читает», «будет читать».", "steps": ["читал — прошедшее время (что делал?).", "читает — настоящее время (что делает?).", "будет читать — будущее время."], "answer": "читал — прош.вр., читает — наст.вр., будет читать — буд.вр."}, {"number": "10", "page": 12, "condition": "Определите склонение: «мама», «папа», «дочь».", "steps": ["мама — ж.р., окончание -а → 1-е скл.", "папа — м.р. (но оканч. -а) → 1-е скл.", "дочь — ж.р., окончание нулевое → 3-е скл."], "answer": "мама — 1 скл., папа — 1 скл., дочь — 3 скл."}, {"number": "11", "page": 13, "condition": "Составьте словосочетание «существительное + прилагательное».", "steps": ["Существительное: лес. Прилагательное: зелёный.", "Словосочетание: зелёный лес."], "answer": "Зелёный лес."}, {"number": "18", "page": 15, "condition": "Разберите предложение: «Мама купила новое платье».", "steps": ["Мама — подлежащее (кто?).", "купила — сказуемое.", "платье — дополнение (что?).", "новое — определение (какое?)."], "answer": "Мама (подл.) купила (сказ.) новое (опред.) платье (доп.)."}, {"number": "28", "page": 20, "condition": "Найдите в предложении однородные члены: «На полянке росли ромашки, колокольчики и васильки».", "steps": ["Однородные подлежащие: ромашки, колокольчики, васильки (отвечают на вопрос что? относятся к одному глаголу)."], "answer": "ромашки, колокольчики, васильки — однородные подлежащие."}, {"number": "48", "page": 27, "condition": "Определите тип склонения: «дядя», «путь», «стол».", "steps": ["дядя — м.р., оканч. -я → 1 скл.", "путь — м.р., разносклоняемое (особое).", "стол — м.р., нулевое оконч. → 2 скл."], "answer": "дядя — 1 скл.; путь — особое; стол — 2 скл."}]}, {"title": "Имя существительное", "problems": [{"number": "41", "page": 23, "condition": "Определите падеж существительного в словосочетании «смотреть на небо».", "steps": ["Смотреть на что? — на небо (В.п. с предлогом «на»).", "Но здесь управление: смотреть (на что?) → небо (В.п.)."], "answer": "Винительный падеж с предлогом «на»."}, {"number": "58", "page": 32, "condition": "Определите падеж: «гулять в парке», «выйти из парка».", "steps": ["в парке — предлог «в» + вопрос «в чём?» → Предложный.", "из парка — предлог «из» + вопрос «откуда?» → Родительный."], "answer": "в парке — П.п.; из парка — Р.п."}, {"number": "65", "page": 36, "condition": "Просклоняйте «окно» (все падежи).", "steps": ["И.п. окно, Р.п. окна, Д.п. окну, В.п. окно, Т.п. окном, П.п. об окне."], "answer": "окно, окна, окну, окно, окном, об окне."}, {"number": "148", "page": 76, "condition": "Образуйте сравнительную степень прилагательных: «умный», «красивый».", "steps": ["умный → умнее (суффикс -ее).", "красивый → красивее."], "answer": "умнее, красивее."}]}, {"title": "Имя прилагательное", "problems": [{"number": "141", "page": 73, "condition": "Образуйте краткое прилагательное от «красивый».", "steps": ["красивый → красив (м.р.), красива (ж.р.), красиво (ср.р.)."], "answer": "красив, красива, красиво."}, {"number": "155", "page": 80, "condition": "Запишите прилагательное «хороший» в превосходной степени.", "steps": ["Превосходная степень: самый хороший, наилучший (супплетивная форма)."], "answer": "самый хороший / наилучший."}, {"number": "165", "page": 85, "condition": "Образуйте прилагательное от существительного «серебро» с помощью суффикса -ян-.", "steps": ["серебро + -ян- = серебряный (1 н, суффикс -ян-)."], "answer": "серебряный."}, {"number": "228", "page": 118, "condition": "Просклоняйте местоимение «я» (И.п., Р.п., Д.п., В.п.).", "steps": ["И.п. я, Р.п. меня, Д.п. мне, В.п. меня."], "answer": "я, меня, мне, меня."}]}, {"title": "Местоимение", "problems": [{"number": "221", "page": 115, "condition": "Определите лицо местоимения: «он», «мы», «вы».", "steps": ["он — 3-е лицо, ед.ч.", "мы — 1-е лицо, мн.ч.", "вы — 2-е лицо, мн.ч."], "answer": "он — 3 л. ед.ч.; мы — 1 л. мн.ч.; вы — 2 л. мн.ч."}, {"number": "238", "page": 122, "condition": "Замените существительное местоимением: «Ваня читает книгу. Ваня рассказал о ней».", "steps": ["Второе упоминание «Ваня» → он.", "Ваня читает книгу. Он рассказал о ней."], "answer": "Он рассказал о ней."}, {"number": "280", "page": 142, "condition": "Образуйте глагол несовершенного вида от «написать».", "steps": ["написать (сов. вид) → писать (несов. вид)."], "answer": "писать."}]}, {"title": "Глагол", "problems": [{"number": "271", "page": 139, "condition": "Определите вид глагола: «рисовать», «нарисовать».", "steps": ["рисовать — что делать? → несовершенный вид.", "нарисовать — что сделать? → совершенный вид."], "answer": "рисовать — несов. вид; нарисовать — сов. вид."}, {"number": "275", "page": 141, "condition": "Спрягите глагол «писать» в настоящем времени.", "steps": ["я пишу, ты пишешь, он/она пишет, мы пишем, вы пишете, они пишут."], "answer": "пишу, пишешь, пишет, пишем, пишете, пишут."}, {"number": "288", "page": 146, "condition": "Проспрягайте глагол «любить» во 2-м лице.", "steps": ["ты любишь (ед.ч.), вы любите (мн.ч.)."], "answer": "ты любишь; вы любите."}, {"number": "295", "page": 150, "condition": "Определите время и лицо глагола «поёт».", "steps": ["Поёт — настоящее время, 3-е лицо, ед.ч."], "answer": "Настоящее время, 3 лицо, единственное число."}, {"number": "305", "page": 156, "condition": "Образуйте форму прошедшего времени: «бежать», «лететь».", "steps": ["бежать → бежал (м.р.), бежала (ж.р.).", "лететь → летел, летела."], "answer": "бежал/бежала; летел/летела."}]}], "source": "reshak"}