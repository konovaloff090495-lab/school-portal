{"slug": "kolmogorov-10", "klass": 10, "subjectSlug": "algebra-nachala-analiza", "subject": "Алгебра и начала анализа", "authors": "Колмогоров А. Н., Абрамов А. М., Дудницын Ю. П.", "type": "Учебник", "years": "2019–2023", "publisher": "Просвещение", "fgos": true, "parts": "1", "chapters": [{"title": "§ 1. Функции и их свойства", "problems": [{"number": "1", "page": 4, "condition": "Найдите область определения функции <b>y = √(x − 3)</b>.", "steps": ["Выражение под корнем должно быть ≥ 0: x − 3 ≥ 0.", "x ≥ 3.", "D(y) = [ 3; +∞)."], "answer": "D(y) = [3; +∞)."}, {"number": "5", "page": 7, "condition": "Вычислите: <b>log₂ 32</b>.", "steps": ["log₂ 32 = log₂ 2⁵ = 5."], "formulas": ["logₐ aⁿ = n"], "answer": "5."}, {"number": "3", "page": 5, "condition": "Найдите область определения функции <b>y = 1/(x+2)</b>.", "steps": ["Знаменатель ≠ 0: x + 2 ≠ 0, x ≠ −2.", "D(y) = (−∞;−2)∪(−2;+∞)."], "answer": "D = ℝ \\ {−2}."}, {"number": "6", "page": 6, "condition": "Является ли функция <b>y = x²</b> чётной?", "steps": ["f(−x) = (−x)² = x² = f(x).", "f(−x) = f(x) → функция чётная."], "answer": "Да, чётная (f(−x) = f(x))."}, {"number": "8", "page": 8, "condition": "Найдите асимптоту функции <b>y = 1/x</b>.", "steps": ["При x → 0: y → ∞ (вертикальная асимптота x = 0).", "При x → ∞: y → 0 (горизонтальная асимптота y = 0)."], "answer": "x = 0 (верт.), y = 0 (гориз.)."}]}, {"title": "§ 2. Производная", "problems": [{"number": "10", "page": 10, "condition": "Найдите производную: <b>y = x³</b>.", "steps": ["Применяем формулу (xⁿ)′ = n·xⁿ⁻¹.", "y′ = 3x²."], "formulas": ["(xⁿ)' = nxⁿ⁻¹"], "answer": "y' = 3x²."}, {"number": "15", "page": 13, "condition": "Найдите производную: <b>y = 5x² − 3x + 2</b>.", "steps": ["y′ = (5x²)′ − (3x)′ + (2)′ = 10x − 3 + 0 = 10x − 3."], "answer": "y' = 10x − 3."}, {"number": "20", "page": 16, "condition": "Найдите точку экстремума функции <b>y = x² − 4x + 3</b>.", "steps": ["y' = 2x − 4.", "Приравниваем к нулю: 2x − 4 = 0, x = 2.", "y(2) = 4 − 8 + 3 = −1. Минимум в точке (2; −1)."], "answer": "Минимум в точке (2; −1)."}, {"number": "41", "page": 20, "condition": "Найдите производную: <b>y = 4x⁴ − 2x</b>.", "steps": ["y′ = 16x³ − 2."], "answer": "y' = 16x³ − 2."}, {"number": "45", "page": 22, "condition": "Найдите точки, где функция <b>y = x³ − 3x</b> имеет экстремумы.", "steps": ["y' = 3x² − 3 = 0 → x² = 1 → x = ±1.", "При x = 1: y'' = 6 > 0 → минимум. При x = −1: y'' = −6 < 0 → максимум."], "answer": "Максимум при x = −1, минимум при x = 1."}, {"number": "50", "page": 24, "condition": "Напишите уравнение касательной к <b>y = x²</b> в точке x = 3.", "steps": ["y' = 2x → при x=3: k = 6.", "Точка (3;9). Касательная: y − 9 = 6(x − 3) → y = 6x − 9."], "answer": "y = 6x − 9."}]}, {"title": "§ 3. Тригонометрические функции", "problems": [{"number": "25", "page": 20, "condition": "Вычислите: <b>sin 30°</b>.", "steps": ["sin 30° = 1/2 (табличное значение)."], "answer": "1/2."}, {"number": "30", "page": 24, "condition": "Вычислите: <b>cos 60°</b>.", "steps": ["cos 60° = 1/2 (табличное значение)."], "answer": "1/2."}, {"number": "35", "page": 28, "condition": "Решите уравнение: <b>sin x = 1/2</b>.", "steps": ["x = π/6 + 2πn или x = 5π/6 + 2πn, n ∈ ℤ.", "В градусах: x = 30° + 360°n или x = 150° + 360°n."], "answer": "x = π/6 + 2πn, x = 5π/6 + 2πn."}, {"number": "101", "page": 52, "condition": "Вычислите: <b>tg 45°</b>.", "steps": ["tg 45° = sin45°/cos45° = (√2/2)/(√2/2) = 1."], "answer": "1."}, {"number": "105", "page": 54, "condition": "Упростите: <b>sin²x + cos²x</b>.", "steps": ["Основное тригонометрическое тождество: sin²x + cos²x = 1."], "answer": "1."}, {"number": "110", "page": 56, "condition": "Решите уравнение: <b>cos x = 0</b>.", "steps": ["x = π/2 + πn, n ∈ ℤ."], "answer": "x = π/2 + πn."}]}, {"title": "§ 4. Интеграл", "problems": [{"number": "40", "page": 32, "condition": "Вычислите интеграл: <b>∫ 2x dx</b>.", "steps": ["∫ 2x dx = x² + C."], "formulas": ["∫ xⁿ dx = xⁿ⁺¹/(n+1) + C"], "answer": "x² + C."}, {"number": "45", "page": 36, "condition": "Найдите площадь фигуры, ограниченной <b>y = x²</b>, x = 0, x = 2.", "steps": ["S = ∫₀² x² dx = [x³/3]₀² = 8/3 − 0 = 8/3."], "formulas": ["S = ∫ₐᵇ f(x)dx"], "answer": "8/3 ≈ 2,67 кв.ед."}, {"number": "171", "page": 88, "condition": "Вычислите: <b>∫₀¹ x dx</b>.", "steps": ["[x²/2]₀¹ = 1/2 − 0 = 1/2."], "answer": "1/2."}, {"number": "175", "page": 90, "condition": "Найдите площадь между <b>y = x</b> и осью x от 0 до 4.", "steps": ["S = ∫₀⁴ x dx = [x²/2]₀⁴ = 8."], "answer": "8 кв.ед."}]}], "source": "reshak"}